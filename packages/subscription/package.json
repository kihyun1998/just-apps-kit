{
  "name": "@just-apps/subscription",
  "version": "0.2.3",
  "description": "Just Apps shared subscription UI components (pricing, subscription status, upgrade modal, trial banner, checkout activation) — framework-agnostic, props-only, Tailwind token driven.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-apps/just-apps-homepage.git",
    "directory": "packages/subscription"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "lucide-react": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5"
  }
}
