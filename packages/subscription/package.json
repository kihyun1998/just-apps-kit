{
  "name": "@just-apps/subscription",
  "version": "0.4.0",
  "description": "Just Apps shared subscription package: UI components (pricing, subscription status, upgrade modal, trial banner, checkout activation), a server-safe core (types + plan constants) and a client data layer (Zustand store + hooks).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kihyun1998/just-apps-kit.git",
    "directory": "packages/subscription"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.mjs",
      "require": "./dist/store.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "lucide-react": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "tailwind-merge": "^3",
    "zustand": "^5",
    "@supabase/supabase-js": "^2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "zustand": "^5.0.12",
    "@supabase/supabase-js": "^2.100.0"
  },
  "peerDependenciesMeta": {
    "zustand": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  }
}
