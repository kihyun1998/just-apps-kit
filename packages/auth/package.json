{
  "name": "@just-apps/auth",
  "version": "0.5.0",
  "description": "Just Apps shared auth UI components (login, terms agreement, my page, user menu, account delete) + the shared terms content — framework-agnostic, props-only, Tailwind token driven.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-apps/just-apps-homepage.git",
    "directory": "packages/auth"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./terms": {
      "types": "./dist/terms.d.ts",
      "import": "./dist/terms.mjs",
      "require": "./dist/terms.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "lucide-react": "^1",
    "boring-avatars": "^2",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "radix-ui": "^1.4",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5"
  }
}
